<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Noppa-SharePoint-Governance</AssemblyName>
    <RootNamespace>NoppaGovernanceApp</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    
    <!-- Assembly Metadata -->
    <Title>Noppa SharePoint &amp; Teams Access Governance</Title>
    <Company>Noppa Solutions &amp; Consultants</Company>
    <Product>Noppa SharePoint &amp; Teams Access Governance Portal</Product>
    <Description>Windows Desktop App voor SharePoint &amp; Teams autorisatie audits en extern toegangsbeheer</Description>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot.zip" />
    <None Update="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>